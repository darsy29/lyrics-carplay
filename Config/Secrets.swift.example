// Secrets.swift.example
//
// Setup:
//   1. Copy this file to App/Secrets.swift  (remove the ".example" part)
//   2. Replace the placeholder below with your own Spotify Client ID
//   3. Add App/Secrets.swift to the LyricsCarPlay target only (not the widget)
//
// App/Secrets.swift is listed in .gitignore, so your ID will not be pushed to GitHub.
// Get a Client ID at https://developer.spotify.com/dashboard

enum Secrets {
    static let spotifyClientID = "YOUR_SPOTIFY_CLIENT_ID"
}
